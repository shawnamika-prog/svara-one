{
  "$schema": "https://unpkg.com/wrangler@4.124.0/config-schema.json",
  "name": "svara-one",
  "main": "worker/entry.js",
  "compatibility_date": "2026-08-18",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "vars": {
    "SVARAONE_FULL_VOICE_CATALOGUE": "true",
    "SVARAONE_FREE_CREDITS": "5000",
    "SVARAONE_FREE_VOICES": "90",
    "SVARAONE_STARTER_PRICE": "120",
    "SVARAONE_STARTER_CREDITS": "75000",
    "SVARAONE_STARTER_VOICES": "90",
    "SVARAONE_CREATOR_PRICE": "240",
    "SVARAONE_CREATOR_CREDITS": "250000",
    "SVARAONE_CREATOR_VOICES": "90",
    "SVARAONE_PRO_PRICE": "480",
    "SVARAONE_PRO_CREDITS": "600000",
    "SVARAONE_PRO_VOICES": "90",
    "SVARAONE_STUDIO_PRICE": "840",
    "SVARAONE_STUDIO_CREDITS": "1500000",
    "SVARAONE_STUDIO_VOICES": "90"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svaraone-db",
      "database_id": "5f6cdada-a902-4c38-bf60-6e42825eec84",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VOICE_SAMPLES",
      "bucket_name": "svaraone-voice-samples"
    },
    {
      "binding": "GENERATED_AUDIO",
      "bucket_name": "svaraone-generations"
    }
  ]
}
