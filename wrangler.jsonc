{
  "$schema": "https://unpkg.com/wrangler@4.124.0/config-schema.json",
  "name": "svara-one",
  "main": "worker/entry.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SVARAONE_CREDIT_FACTOR": "0.5"
  },
  "r2_buckets": [
    {
      "binding": "VOICE_SAMPLES",
      "bucket_name": "svaraone-voice-samples"
    }
  ]
}
